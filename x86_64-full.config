CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_GRUB_IMAGES=y
CONFIG_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=800
#CONFIG_HAS_TESTING_KERNEL=y
#CONFIG_TESTING_KERNEL=y
#CONFIG_LINUX_6_1=y

#版本号显示（覆盖 LEDE 默认的 24.10.5）
CONFIG_VERSION_NUMBER="25.12"

#远程管理插件
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-n2n_v2=n
CONFIG_PACKAGE_luci-app-nps=n
CONFIG_PACKAGE_luci-app-ntpc=n
CONFIG_PACKAGE_luci-app-serverchan=n
CONFIG_PACKAGE_luci-app-watchcat=n

#加入IPV6支持
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_libip4tc=y
CONFIG_PACKAGE_libip6tc=y
CONFIG_PACKAGE_libxtables=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_iptables=y

#虚拟化客户机支持（KVM/Proxmox/ESXi/Hyper-V）
# 当前 x86_64 6.18 内核已内置 VirtIO 与 Hyper-V 客户机驱动，不再选择已移除的 kmod 软件包。
CONFIG_PACKAGE_qemu-ga=y

#移除音频组件（减小体积）
CONFIG_PACKAGE_kmod-sound-core=n
CONFIG_PACKAGE_kmod-sound-hda-core=n
CONFIG_PACKAGE_kmod-sound-hda-codec-realtek=n
CONFIG_PACKAGE_kmod-sound-hda-codec-via=n
CONFIG_PACKAGE_kmod-sound-hda-codec-hdmi=n
CONFIG_PACKAGE_kmod-sound-hda-intel=n
CONFIG_PACKAGE_kmod-sound-via82xx=n
CONFIG_PACKAGE_kmod-sound-i8x0=n
CONFIG_PACKAGE_kmod-usb-audio=n

#加入英文
CONFIG_LUCI_LANG_en=y

#科学软件包
CONFIG_PACKAGE_luci-app-clash=n
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-bypass=n
CONFIG_PACKAGE_luci-app-leigod-acc=n
#CONFIG_PACKAGE_luci-app-passwall2
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set

#磁盘管理
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_mdadm=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_kmod_md_raid456=n
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_kmod_md_linear=n

#主题：默认使用 Argon（jerrykuku 源，diy-part2.sh 单独克隆）
CONFIG_PACKAGE_luci-theme-atmaterial=n
CONFIG_PACKAGE_luci-theme-infinityfreedom=n
CONFIG_PACKAGE_luci-theme-material=n
CONFIG_PACKAGE_luci-theme-netgear=n
CONFIG_PACKAGE_luci-theme-bootstrap=n
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-mcat=n
CONFIG_PACKAGE_luci-theme-neobird=n
CONFIG_PACKAGE_luci-theme-design=n
CONFIG_PACKAGE_luci-theme-material3=n

#未启用 Bootstrap 主题，手动保留 luci 元包的其余组件，避免丢失防火墙/PPP/流量图
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

#加入design主题修改配置
CONFIG_PACKAGE_luci-app-design-config=n

#加入下载插件
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
CONFIG_PACKAGE_luci-app-amule=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-baidupcs-web=n
CONFIG_PACKAGE_luci-app-kodexplorer=n
CONFIG_PACKAGE_luci-app-ramfree=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_fuse-utils=n
CONFIG_PACKAGE_luci-app-iptvhelper=n
CONFIG_PACKAGE_luci-app-cifs-mount=n

#去广告代理插件
CONFIG_PACKAGE_luci-app-dnsfilter=n
# AdGuardHome 编译进固件但默认不启用（含核心二进制，需要时在 LuCI 中手动开启）
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=y
CONFIG_PACKAGE_luci-app-smartdns=n
# MosDNS：DNS 分流，链路 dnsmasq -> MosDNS -> OpenClash
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
#VPN插件
CONFIG_PACKAGE_luci-app-softethervpn=n

#其他不明插件
CONFIG_PACKAGE_luci-app-fwknopd=n
# CONFIG_PACKAGE_luci-app-mtwifi is not set
CONFIG_PACKAGE_luci-app-p910nd=n
CONFIG_PACKAGE_luci-app-verysync=n
CONFIG_PACKAGE_luci-app-airplay2=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-aliyundrive-webdav=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-kcptun=n
CONFIG_PACKAGE_luci-app-ttnode=n
CONFIG_PACKAGE_luci-app-uugamebooster=n
# CONFIG_PACKAGE_luci-app-vssr is not set
CONFIG_PACKAGE_luci-app-poweroff=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cpulimit=y
CONFIG_PACKAGE_luci-app-eqos=y
#TurboAcc：默认只启用 BBR，流量分载与 SQM/EQoS/透明代理冲突，保持在 LuCI 中手动开启
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSFORWARDER=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSPROXY=n
CONFIG_PACKAGE_luci-app-advanced=y
CONFIG_PACKAGE_luci-app-netspeedtest=y


#EasyTier 异地组网
CONFIG_PACKAGE_easytier=y
CONFIG_EASYTIER_INCLUDE_WEBCONSOLE=y
CONFIG_PACKAGE_luci-app-easytier=y

#基础工具与服务
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y

#常用插件
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-jd-dailybonus=n
CONFIG_PACKAGE_luci-app-netdata=y
# CONFIG_PACKAGE_luci-app-pptp-server is not set
CONFIG_PACKAGE_luci-app-pushbot=n
CONFIG_PACKAGE_luci-app-qos=n
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-minidlna=n
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=n
CONFIG_PACKAGE_luci-app-socat=y
